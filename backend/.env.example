# PostgreSQL (generate_data.py veya kendi kurulumunuz)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=kooperatif_db

# Opsiyonel bağlantı havuzu
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# LLM — yalnızca OpenAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key-here

# JWT (satıcı login — üretimde güçlü rastgele anahtar kullanın)
JWT_SECRET_KEY=kooperatif-jwt-secret-2024

# RAG / Chroma (embedding için OPENAI_API_KEY kullanılır)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_PERSIST_DIR=   # boş bırakılırsa backend/chroma_db kullanılır
